# Server-only Fireworks settings. Manual authoring works without them.
# This model supports photos; use the exact Fireworks model ID.
AI_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_API_KEY=

# Server-only ElevenLabs key for optional voice input (Scribe v2).
# Enable the key's Speech to Text (speech_to_text) permission.
ELEVENLABS_API_KEY=
