# Server-only OpenAI settings. Manual authoring works without them.
# Set the exact ID of an accessible image-capable model supporting Structured Outputs.
# Use a model ID, without an "openai:" prefix.
AI_MODEL=
OPENAI_API_KEY=

# Server-only ElevenLabs key for optional voice input (Scribe v2).
# Enable the key's Speech to Text (speech_to_text) permission.
ELEVENLABS_API_KEY=
